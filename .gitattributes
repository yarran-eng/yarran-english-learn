# 统一换行符策略：文本文件入库使用 LF
* text=auto

*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# 二进制文件禁止行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
